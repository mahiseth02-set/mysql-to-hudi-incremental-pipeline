{
  "source": {
    "url": "jdbc:mysql://127.0.0.1:3306/shop_demo?useSSL=false&allowPublicKeyRetrieval=true",
    "driver": "com.mysql.cj.jdbc.Driver",
    "user": "etl_reader",
    "password_env": "MYSQL_PASSWORD",
    "table": "orders",
    "key": "order_id",
    "watermark_col": "updated_at",
    "num_partitions": 8,
    "fetch_size": 10000
  },
  "target": {
    "path": "hdfs:///lake/shop_demo/orders",
    "table_name": "orders",
    "precombine": "updated_at",
    "partition": "order_date",
    "table_type": "MERGE_ON_READ",
    "compact_every_commits": 3,
    "parallelism": 8
  },
  "state_path": "state/orders_watermark.json",
  "overlap_minutes": 10
}
